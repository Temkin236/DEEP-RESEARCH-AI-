# Deep Research AI Backend Configuration

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# Primary LLM Provider: "gemini" or "openai" or "demo"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional OpenAI Provider Adapter
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Search Provider: "duckduckgo", "tavily", "serper", or "demo"
# When set to "demo", deterministic curated high-quality sources are used for testing & presentations
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SERPER_API_KEY=

# Database Configuration
# Defaults to local SQLite for seamless setup; use postgresql://user:pass@localhost:5432/deep_research in production
DATABASE_URL=sqlite:///./deep_research.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deep_research

# Chroma Vector Store Persistence
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Document Ingestion Limits
MAX_UPLOAD_SIZE_MB=25
MAX_CHUNKS_PER_QUERY=5

# Agent System Parameters
MAX_RESEARCH_ITERATIONS=2
MAX_SOURCES_PER_QUERY=8
RESEARCH_TIMEOUT_SECONDS=180
